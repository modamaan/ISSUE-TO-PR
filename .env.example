# ─────────────────────────────────────────────────────────────────────────────
# IssueToPR — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Model to use for code generation and auto-fix (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# ── GitHub ───────────────────────────────────────────────────────────────────
# Personal Access Token with scopes: contents:write, pull_requests:write, issues:read
GITHUB_TOKEN=ghp_...

# Repository to watch for issues (owner/repo)
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=your-repo

# Webhook secret — set the same value in GitHub repo Settings → Webhooks
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Optional: only process issues with this label (leave blank to process all)
GITHUB_ISSUE_LABEL=ai-autofix

# ── Redis (task queue) ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Pipeline behaviour ────────────────────────────────────────────────────────
# Risk score threshold above which the PR is opened as DRAFT (requires human review)
RISK_SCORE_DRAFT_THRESHOLD=70

# Max files the codegen agent will touch per issue (safety guard)
MAX_FILES_PER_ISSUE=10

# Timeout (seconds) for each agent step
AGENT_TIMEOUT_SECONDS=120

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Optional: Semgrep ─────────────────────────────────────────────────────────
# Set to your Semgrep App Token to use Pro rules (leave blank for OSS rules only)
SEMGREP_APP_TOKEN=
